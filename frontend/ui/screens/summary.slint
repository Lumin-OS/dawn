import { Button, ScrollView } from "std-widgets.slint";
import { PartitionInfo } from "disk.slint";

// SPEC.md: "Lists every change, says online or offline install, names
// the disk to be wiped, needs an explicit confirm." Nothing touches a
// disk before this screen's confirm, and the disk is named by model,
// size and serial, not just a device path (SPEC.md "Disk safety").
export component SummaryScreen inherits VerticalLayout {
    // How the Welcome, Keyboard and Timezone lists show what was picked.
    in property <string> locale-label;
    in property <string> keyboard-label;
    in property <string> timezone-label;
    in property <string> disk-model;
    in property <int> disk-size-gib;
    in property <string> disk-serial;
    in property <string> disk-device;
    in property <string> disk-mode;
    in property <[PartitionInfo]> partitions;
    in property <bool> is-offline;
    in property <string> network-profile;
    in property <string> full-name;
    in property <string> username;
    in property <string> hostname;
    in property <bool> autologin;
    in property <bool> secure-boot-enroll;
    // What the backend's `validate` found wrong with the plan, if
    // anything; the install doesn't start until it's fixed.
    in property <string> problems;

    callback back();
    callback confirm();

    padding: 32px;
    spacing: 10px;

    Text { text: @tr("Summary"); font-size: 22px; font-weight: 700; }
    Text { text: @tr("Nothing is changed until you confirm."); wrap: word-wrap; }

    Text { text: @tr("Language: {}", locale-label); }
    Text { text: @tr("Keyboard: {}", keyboard-label); }
    Text { text: @tr("Timezone: {}", timezone-label); }
    Text {
        text: is-offline
            ? @tr("Install: offline, from this live image")
            : @tr("Install: online, from the package repositories");
    }
    if network-profile != "": Text { text: @tr("Wi-Fi: {} is set up on the new system too", network-profile); }
    Text {
        text: disk-mode == "manual"
            ? @tr("Disk: {} ({} GiB, serial {}) — only assigned partitions will be used", disk-model, disk-size-gib, disk-serial)
            : @tr("Disk: {} ({} GiB, serial {}) will be erased completely", disk-model, disk-size-gib, disk-serial);
        wrap: word-wrap;
        font-weight: 700;
    }
    if disk-mode == "manual": ScrollView {
        min-height: 80px;
        VerticalLayout {
            for partition in partitions: Text {
                text: partition.mount-point == "" ? @tr("{}: untouched", partition.device)
                    : partition.format ? @tr("{} → {}: FORMAT (all existing files lost)", partition.device, partition.mount-point)
                    : @tr("{} → {}: reuse filesystem", partition.device, partition.mount-point);
                wrap: word-wrap;
            }
        }
    }
    Text { text: disk-device; font-size: 12px; color: #888888; }
    Text {
        text: secure-boot-enroll
            ? @tr("Secure Boot: will be set up")
            : @tr("Secure Boot: not set up now");
    }
    Text {
        text: autologin
            ? @tr("User: {} ({}) on {}, logs in automatically", full-name, username, hostname)
            : @tr("User: {} ({}) on {}", full-name, username, hostname);
        wrap: word-wrap;
    }

    Rectangle { vertical-stretch: 1; }

    if problems != "": Text {
        text: @tr("This can't be installed yet:\n{}", problems);
        wrap: word-wrap;
        color: #d9534f;
    }

    HorizontalLayout {
        spacing: 12px;
        Button { text: @tr("Back"); clicked => { back(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Install"); primary: true; clicked => { confirm(); } }
    }
}
