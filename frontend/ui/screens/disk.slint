import { Button, CheckBox, ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct PartitionInfo {
    device: string,
    description: string,
    mount-point: string,
    format: bool,
    unavailable: bool,
}

export struct DiskInfo {
    device: string,
    model: string,
    size-gib: int,
    serial: string,
    // Why this disk can't be installed onto; empty if it can.
    unavailable: string,
    partitions: [PartitionInfo],
}

// SPEC.md: "Target disk, Erase or Manual mode, Secure Boot setup |
// Shows model, size and serial; hides the live USB; Secure Boot
// checkbox appears only in Setup Mode, checked by default." The backend
// already left out the live USB and mounted disks; disks too small or
// otherwise unusable are shown greyed out with the reason. Manual
// mode assigns existing partitions; it never changes the partition table.
export component DiskScreen inherits VerticalLayout {
    in property <[DiskInfo]> disks;
    in-out property <[PartitionInfo]> partitions;
    in-out property <string> selected-device;
    in-out property <string> selected-model;
    in-out property <int> selected-size-gib;
    in-out property <string> selected-serial;
    in-out property <string> mode: "erase";
    in property <bool> is-setup-mode;
    in-out property <bool> secure-boot-enroll;

    callback back();
    callback next();

    padding: 20px;
    spacing: 8px;

    Text { text: @tr("Disk"); font-size: 22px; font-weight: 700; }
    Text { text: @tr("Choose the disk to install onto. Erase mode wipes it completely."); wrap: word-wrap; }

    if disks.length == 0: Text {
        text: @tr("No disk this PC can install onto was found.");
        color: #d9534f;
    }

    ScrollView {
        vertical-stretch: 1;
        min-height: 80px;
        VerticalLayout {
            spacing: 8px;
            for disk in disks: Rectangle {
                border-radius: 6px;
                border-width: 2px;
                border-color: disk.device == selected-device ? Theme.accent : #cccccc;
                background: disk.device == selected-device ? Theme.accent.with-alpha(0.08) : transparent;
                opacity: disk.unavailable == "" ? 1.0 : 0.5;
                height: 64px;
                accessible-role: list-item;
                accessible-label: "\{disk.model} \{disk.serial}";
                accessible-enabled: disk.unavailable == "";
                accessible-action-default => {
                    if disk.unavailable == "" {
                        partitions = disk.partitions;
                        selected-device = disk.device;
                        selected-model = disk.model;
                        selected-size-gib = disk.size-gib;
                        selected-serial = disk.serial;
                    }
                }

                TouchArea {
                    enabled: disk.unavailable == "";
                    clicked => {
                        partitions = disk.partitions;
                        selected-device = disk.device;
                        selected-model = disk.model;
                        selected-size-gib = disk.size-gib;
                        selected-serial = disk.serial;
                    }
                }

                VerticalLayout {
                    padding: 10px;
                    Text { text: @tr("{} — {} GiB", disk.model, disk.size-gib); font-weight: 600; }
                    Text {
                        text: disk.unavailable == ""
                            ? @tr("Serial {}", disk.serial)
                            : @tr("Serial {} — this disk {}", disk.serial, disk.unavailable);
                        font-size: 12px;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Text { text: @tr("Mode:"); vertical-alignment: center; }
        Button { text: @tr("Erase"); primary: mode == "erase"; clicked => { mode = "erase"; } }
        Button { text: @tr("Manual"); primary: mode == "manual"; clicked => { mode = "manual"; } }
    }

    if mode == "manual": VerticalLayout {
        spacing: 6px;
        Text { text: @tr("Assign /boot to an ESP and / to root. Root will be formatted. Leave mount points empty to preserve unassigned partitions."); wrap: word-wrap; }
        if partitions.length == 0: Text { text: @tr("No existing partitions found. Manual mode does not create partitions."); }
        ScrollView {
            min-height: 140px;
            VerticalLayout {
                for partition[i] in partitions: HorizontalLayout {
                    spacing: 6px;
                    Text { text: partition.description; wrap: word-wrap; horizontal-stretch: 1; }
                    LineEdit {
                        text <=> partition.mount-point;
                        accessible-label: "Mount point \{partition.device}";
                        placeholder-text: @tr("Unused");
                        enabled: !partition.unavailable;
                        edited => { if self.text == "/" { partition.format = true; } }
                    }
                    CheckBox {
                        text: @tr("Format");
                        accessible-label: "Format \{partition.device}";
                        checked <=> partition.format;
                        enabled: !partition.unavailable && partition.mount-point != "" && partition.mount-point != "/";
                    }
                }
            }
        }
    }

    if is-setup-mode: CheckBox {
        text: @tr("Set up Secure Boot with {} keys", Theme.product-name);
        checked <=> secure-boot-enroll;
    }

    HorizontalLayout {
        spacing: 12px;
        Button { text: @tr("Back"); clicked => { back(); } }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: @tr("Next");
            primary: true;
            enabled: selected-device != "" && (mode == "erase" || partitions.length >= 2);
            clicked => { next(); }
        }
    }
}
